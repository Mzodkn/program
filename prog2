async function postJSON(url, body, ms){
  const ctl=new AbortController(); const t=setTimeout(()=>ctl.abort(),ms);
  try{
    const r=await fetch(url,{method:'POST',headers:{'Content-Type':'application/json','Accept':'application/json'},body:JSON.stringify(body),signal:ctl.signal});
    if(!r.ok) throw new Error('HTTP '+r.status);
    return await r.json();
  } finally { clearTimeout(t); }
}
async function runWandbox(code,stdin){
  const r=await postJSON('https://wandbox.org/api/compile.json',{code:code,compiler:'gcc-head',stdin:stdin,options:'','compiler-option-raw':'-std=c++17',save:false},30000);
  let out='';
  if(r.compiler_error) out+=r.compiler_error;
  if(r.program_output) out+=(out?'\n':'')+r.program_output;
  if(r.program_error) out+=(out?'\n':'')+r.program_error;
  if(!out) out=(String(r.status)==='0')?'(no output)':'Exit status '+r.status;
  return out;
}
async function runGodbolt(code,stdin){
  const r=await postJSON('https://godbolt.org/api/compiler/g132/compile',{source:code,lang:'c++',options:{userArguments:'-std=c++17',executeParameters:{args:[],stdin:stdin},compilerOptions:{executorRequest:true},filters:{execute:true},tools:[],libraries:[]}},30000);
  const txt=a=>(a||[]).map(x=>x.text).join('\n');
  const b=r.buildResult||{};
  if(b.code!==undefined && b.code!==0) return 'Compiler errors:\n'+txt(b.stderr);
  let out=txt(r.stdout); const e=txt(r.stderr);
  if(e) out+=(out?'\n':'')+e;
  return out||'(no output)';
}
async function runLab(){
  const code=$('labCode').value, stdin=$('labIn').value, outEl=$('labOut'), btn=$('labRun');
  state.labCode=code; state.labIn=stdin;
  btn.disabled=true; btn.classList.add('opacity-60');
  outEl.textContent=u('running');
  let out;
  try{ out=await runWandbox(code,stdin); }
  catch(e1){
    try{ out=await runGodbolt(code,stdin); }
    catch(e2){ out=u('noNet'); }
  }
  state.labOut=out; outEl.textContent=out;
  btn.disabled=false; btn.classList.remove('opacity-60');
}

/* ---------- FINAL EXAM ---------- */
function pool(){ const p=[]; LECT().forEach(l=>l.quiz.forEach(q=>p.push(q))); return p; }
function newExam(size){
  const qs=shuf(pool()).slice(0,size).map(mixQ);
  state.exam={qs,i:0,score:0,wrong:[],finished:false,size};
}
function renderExam(){
  const e=state.exam, total=pool().length, d=sd();
  if(!e){
    const sizes=[20,40,total];
    return `<div class="fade text-center py-8"><h1 class="text-3xl font-extrabold mb-2">🏆 ${u('exam')}</h1>
      <p class="text-dark-muted mb-1">${state.lang==='ar'?`بنك الأسئلة: ${total} سؤالًا من كل المحاضرات. تتغير الأسئلة وترتيب الخيارات في كل مرة.`:`Question bank: ${total} questions from all lectures. Questions and answer order change every time.`}</p>
      <p class="mono text-sm text-dark-muted mb-6">${u('best')}: ${d.exam?d.exam+'%':'—'}</p>
      <p class="font-semibold mb-3">${u('chooseSize')}</p>
      <div class="flex flex-wrap justify-center gap-3">${sizes.map((n,i)=>`<button data-size="${n}" class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold"><span class="mono">${n}</span> ${i===2?`(${u('all')})`:u('questions')}</button>`).join('')}</div></div>`;
  }
  if(e.finished){
    const p=Math.round(e.score/e.qs.length*100);
    return `<div class="fade py-6"><div class="text-center">
      <h1 class="text-3xl font-extrabold mb-3">🏆 ${u('exam')}</h1>
      <div class="mono text-5xl font-extrabold ${p>=90?'text-green-400':p>=60?'text-amber-400':'text-red-400'} mb-2">${e.score}/${e.qs.length}</div>
      <div class="mono text-xl mb-4">${p}%</div>
      <p class="mb-6">${p>=90?(state.lang==='ar'?'ممتاز! أنت جاهز للامتحان 🎉':'Excellent! You are ready 🎉'):(state.lang==='ar'?'راجع المحاضرات وأعد المحاولة للوصول إلى 90%+':'Review the lectures and try again to reach 90%+')}</p>
      <button data-act="examAgain" class="px-6 py-3 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-bold">${u('retry')}</button></div>
      ${e.wrong.length?`<h2 class="font-bold text-lg mt-8 mb-3">❌ ${u('mistakes')} (${e.wrong.length})</h2>
      ${e.wrong.map(w=>`<div class="bg-dark-elevated border border-dark-border border-s-4 border-s-red-500 rounded-xl p-4 mb-3"><div class="font-semibold mb-1">${tx(w.q)}</div><div class="text-sm text-green-400">${u('yourAns')}: ${tx(w.c)}</div></div>`).join('')}`:''}
    </div>`;
  }
  const q=e.qs[e.i];
  return `<div class="fade"><h1 class="text-2xl font-extrabold mb-3">🏆 ${u('exam')}</h1>
    <div class="h-2 bg-dark-surface rounded-full mb-4 overflow-hidden"><div class="h-full bg-brand-500" style="width:${e.i/e.qs.length*100}%"></div></div>
    <div data-exam="1">${qHTML(q,e.i+1,e.qs.length)}</div>
    <div class="flex justify-between items-center"><span class="mono text-sm text-dark-muted">${u('score')}: ${e.score}</span>
    <button id="examNext" class="hidden px-5 py-2 rounded-lg bg-brand-600 text-white">${e.i===e.qs.length-1?u('finish'):u('next')}</button></div></div>`;
}

/* ============================================================
   SHELL: nav, layout, render
   ============================================================ */
function renderNav(){
  const item=(id,icon,label,extra='')=>`<button data-go="${id}" class="w-full flex items-center gap-3 text-start px-3 py-2.5 rounded-lg transition ${state.page===id?'bg-brand-600 text-white':'hover:bg-dark-elevated text-dark-text'}"><span>${icon}</span><span class="flex-1 text-sm">${label}</span>${extra}</button>`;
  const head=t=>`<div class="px-3 pt-3 pb-1 text-xs uppercase tracking-wider text-dark-muted">${t}</div>`;
  const s=subj(), d=sd();
  let h=`<a href="index.html" class="w-full flex items-center gap-3 px-3 py-2.5 rounded-lg hover:bg-dark-elevated text-dark-text"><span>🗂️</span><span class="flex-1 text-sm">${u('hub')}</span></a>`;
  h += `<div class="px-3 pt-3 pb-1 text-sm font-bold text-brand-500">${s.icon} ${tx(s.name)}</div>`;
  h += item('home','🏠',u('home'));
  h += head(u('lectures')) + s.lectures.map(l=>item(l.id,`<span class="mono text-xs">${l.n}</span>`,tx(l.title),d.best[l.id]!=null?`<span class="mono text-[10px] opacity-80">${d.best[l.id]}%</span>`:'')).join('');
  h += head(u('tools')) + item('lab','🧪',u('lab')) + item('exam','🏆',u('exam'),d.exam?`<span class="mono text-[10px] opacity-80">${d.exam}%</span>`:'') + item('glossary','📖','Glossary / قاموس المصطلحات');
  $('nav').innerHTML=h;
}
function applyLayout(){
  const sb=$('sidebar'), main=$('main'), bd=$('backdrop');
  sb.classList.toggle('ltr:-translate-x-full',!state.sidebar);
  sb.classList.toggle('rtl:translate-x-full',!state.sidebar);
  main.classList.toggle('lg:ps-72',state.sidebar);
  bd.classList.toggle('hidden',!(state.sidebar && window.innerWidth<1024));
}
function updateTop(){
  const show=!!state.subject, m=show?mastery(subj()):0;
  $('topProgWrap').classList.toggle('hidden',!show); $('topProgWrap').classList.toggle('sm:flex',show);
  $('topBar').style.width=m+'%'; $('topPct').textContent=m+'%';
}
function render(){
  document.documentElement.lang=state.lang;
  document.documentElement.dir=state.lang==='ar'?'rtl':'ltr';
  $('langBtn').textContent = state.lang==='ar'?'English':'العربية';
  applyTheme();
  const lects = state.subject?LECT():[];
  const idx=lects.findIndex(l=>l.id===state.page);
  let html='', title='';
  if(state.page==='home'){ html=renderHome(); title=tx(subj().name).replace(/<[^>]+>/g,''); }
  else if(idx>=0){ html=renderLecture(lects[idx],idx); title=`${u('lecture')} ${lects[idx].n}`; }
  else if(state.page==='exam'){ html=renderExam(); title=u('exam'); }
  else if(state.page==='lab'){ html=renderLab(); title=u('lab'); }
  else if(state.page==='glossary'){ html=renderGlossary(); title='Glossary / قاموس المصطلحات'; }
  $('app').innerHTML=html; $('topTitle').textContent=title;
  updateTop(); renderNav(); applyLayout();
}
function go(p){
  state.page=p; state.qz={}; state.decks={}; if(p!=='exam') state.exam=null;
  if(window.innerWidth<1024) state.sidebar=false;
  render(); window.scrollTo({top:0,behavior:'smooth'});
}

/* ============================================================
   EVENTS
   ============================================================ */
document.addEventListener('click',e=>{
  const g=e.target.closest('[data-go]'); if(g){ go(g.dataset.go); return; }

  const sz=e.target.closest('[data-size]'); if(sz){ newExam(+sz.dataset.size); render(); window.scrollTo({top:0}); return; }

  const opt=e.target.closest('.opt');
  if(opt){
    const box=opt.closest('.qbox'); if(box.dataset.done) return;
    box.dataset.done='1';
    const a=+box.dataset.a, i=+opt.dataset.i, ok=(i===a);
    if(ok) box.dataset.ok='1';
    box.querySelectorAll('.opt').forEach(b=>{
      b.disabled=true; b.classList.remove('hover:border-brand-500'); b.classList.add('cursor-not-allowed');
      if(+b.dataset.i===a) b.classList.add('!bg-green-600/30','!border-green-500');
    });
    if(!ok) opt.classList.add('!bg-red-600/30','!border-red-500');
    const fb=box.querySelector('.fb'); fb.classList.remove('hidden');
    fb.className='fb mt-3 text-sm font-semibold '+(ok?'text-green-400':'text-red-400');
    fb.textContent=ok?u('correct'):u('wrong');

    const exam=box.closest('[data-exam]');
    if(exam){
      const ex=state.exam, q=ex.qs[ex.i];
      if(ok) ex.score++; else ex.wrong.push({q:q.q,c:q.o[q.a]});
      $('examNext').classList.remove('hidden'); return;
    }
    const qz=box.closest('[data-quiz]');
    if(qz){
      const boxes=[...qz.querySelectorAll('.qbox')];
      if(boxes.every(b=>b.dataset.done)){
        const sc=boxes.filter(b=>b.dataset.ok).length, pct=Math.round(sc/boxes.length*100);
        const sEl=qz.querySelector('.qscore'); sEl.classList.remove('hidden');
        qz.querySelector('.qs-text').textContent=`${u('score')}: ${sc}/${boxes.length} (${pct}%)`;
        const d=sd(), id=qz.dataset.quiz;
        if(d.best[id]==null||pct>d.best[id]){ d.best[id]=pct; save(); }
        updateTop(); renderNav();
      }
    }
    return;
  }

  const a=e.target.closest('[data-act]'); if(!a) return;
  const act=a.dataset.act;
  if(act==='tryit'){ state.labCode=CODES[+a.dataset.code]; state.labOut=''; go('lab'); return; }
  if(act==='lab-run'){ runLab(); return; }
  if(act==='lab-clear'){ state.labCode=''; state.labIn=''; state.labOut=''; render(); return; }
  if(act.startsWith('dk-')){
    const id=a.dataset.deck, d=state.decks[id]; if(!d) return;
    if(act==='dk-flip'){ d.flip=!d.flip; const f=document.querySelector(`#deck-${id} .flip`); if(f) f.classList.toggle('on',d.flip); return; }
    if(act==='dk-next') d.i=(d.i+1)%d.list.length;
    if(act==='dk-prev') d.i=(d.i-1+d.list.length)%d.list.length;
    if(act==='dk-shuf'){ d.list=shuf(d.list); d.i=0; }
    d.flip=false; redrawDeck(id); return;
  }
  if(act==='retryQuiz'){
    const L=LECT().find(l=>l.id===a.dataset.id); delete state.qz[L.id];
    $('quiz-'+L.id).innerHTML=quizInner(L); $('quiz-'+L.id).scrollIntoView({behavior:'smooth',block:'start'}); return;
  }
  if(act==='examAgain'){ state.exam=null; render(); return; }
  if(act==='reset'){ state.data[state.subject]={seen:{},best:{},exam:0}; save(); render(); return; }
});
document.addEventListener('click',e=>{
  if(e.target.id==='examNext'){
    const ex=state.exam;
    if(ex.i<ex.qs.length-1) ex.i++;
    else { ex.finished=true; const p=Math.round(ex.score/ex.qs.length*100), d=sd(); if(p>(d.exam||0)){ d.exam=p; save(); } }
    render(); window.scrollTo({top:0});
  }
});
document.addEventListener('input',e=>{
  if(e.target.id==='gSearch'){
    const q=e.target.value.toLowerCase();
    $('gList').innerHTML=gItems(subj().glossary.filter(g=>(g[0]+' '+g[1]).toLowerCase().includes(q)));
  }
  if(e.target.id==='labCode') state.labCode=e.target.value;
  if(e.target.id==='labIn') state.labIn=e.target.value;
});
document.addEventListener('change',e=>{
  if(e.target.id==='labSample' && e.target.value!==''){
    state.labCode=SAMPLES[+e.target.value].code; state.labOut=''; render();
  }
});
document.addEventListener('keydown',e=>{
  if(e.target.id==='labCode' && e.key==='Tab'){
    e.preventDefault();
    const t=e.target, s=t.selectionStart;
    t.value=t.value.slice(0,s)+'    '+t.value.slice(t.selectionEnd);
    t.selectionStart=t.selectionEnd=s+4; state.labCode=t.value;
  }
});
$('menuBtn').onclick=()=>{ state.sidebar=!state.sidebar; applyLayout(); };
$('backdrop').onclick=()=>{ state.sidebar=false; applyLayout(); };
$('langBtn').onclick=()=>{ state.lang=state.lang==='ar'?'en':'ar'; save(); render(); };
window.addEventListener('resize',applyLayout);

render();
</script>
